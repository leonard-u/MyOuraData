# Port exposed on the host to access the Cracked Oura web UI and API
CRACKED_OURA_PORT=8000

# Host interface the port is published on. The API has NO authentication, so
# keep 127.0.0.1 unless you deliberately want LAN access (then use 0.0.0.0 and
# never expose it to the internet).
CRACKED_OURA_BIND=127.0.0.1

# Host names the API answers to (protects against DNS rebinding). Add the
# name/IP you type in the browser if you enable LAN access, e.g.
# localhost,127.0.0.1,nas.local,192.168.1.20
CRACKED_OURA_ALLOWED_HOSTS=localhost,127.0.0.1

# Host path mapped to /data inside the container (SQLite DB, configs, logs, session)
CRACKED_OURA_DATA_PATH=./data

# Host user/group IDs to match bind-mounted directory ownership
PUID=1000
PGID=1000

# Container timezone
TZ=Europe/Rome

# Ollama endpoint reachable from inside the container for the AI Health Analyst
OLLAMA_HOST=http://host.docker.internal:11434
